# ---------------------------------------------------------------------------
# Nebius Token Factory — all reasoning and generation runs here.
# Get a key at https://tokenfactory.nebius.com
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# ---------------------------------------------------------------------------
# Postgres (Neon). Create a free database at https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Tavily — optional. Powers the company-enrichment tool.
# https://tavily.com
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Who the assistant is working for. Used when signing drafted emails.
# ---------------------------------------------------------------------------
RINGLY_USER_NAME=Alex
RINGLY_USER_EMAIL=alex@example.com
RINGLY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Shared secret that guards the nightly review endpoint against public calls.
# Generate with: node -e "console.log(crypto.randomUUID())"
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Mobile client (Flutter app under mobile/). This server holds every secret
# above and is called over plain HTTP(S) by the app — the app itself never
# sees NEBIUS_API_KEY or DATABASE_URL. Nothing to set here; this section just
# documents the two base URLs the Flutter entrypoints point at:
#   - Android emulator dev build: http://10.0.2.2:3000 (alias for this host)
#   - Production build: the deployed URL of this Next.js app
# See mobile/README.md and docs/flutter-migration-plan.md for details.
# ---------------------------------------------------------------------------
